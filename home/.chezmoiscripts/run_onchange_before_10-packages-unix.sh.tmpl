{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Installs the Homebrew packages listed in .chezmoidata/packages.yaml.
# chezmoi runs this script again whenever the list changes.
set -euo pipefail

BREW={{ .brewPrefix }}/bin/brew
if [ ! -x "$BREW" ]; then
  echo "Homebrew is not installed ($BREW): see the README of the dotfiles repo." >&2
  exit 1
fi

"$BREW" bundle --file=- <<'BREWFILE'
{{ range .packages.brew -}}
brew {{ . | quote }}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.brewCasks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
BREWFILE
{{ end -}}
