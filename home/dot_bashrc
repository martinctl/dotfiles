# Managed by chezmoi: edit it in the dotfiles repo, then run `chezmoi apply`.
# The interactive shell is fish; bash is mostly for agents (Claude Code) and scripts.

# PATH comes before the "interactive" check: agents run bash and need it.
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$HOME/.local/go/bin:$HOME/go/bin:$HOME/.local/share/fnm:$PATH"
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell bash)"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

# The rest only applies to interactive sessions.
case $- in *i*) ;; *) return ;; esac

HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

alias ls='ls --color=auto' grep='grep --color=auto' ll='ls -alF'
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --color=16"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"
if command -v fd >/dev/null; then
  export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git"
fi
command -v fzf >/dev/null && eval "$(fzf --bash)"

if command -v eza >/dev/null; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -l --git --icons=auto --group-directories-first --time-style=relative'
  alias la='eza -la --git --icons=auto --group-directories-first --time-style=relative'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
fi
export BAT_THEME_DARK="Monokai Extended" BAT_THEME_LIGHT="GitHub"
command -v bat >/dev/null && alias cat='bat --paging=never'
command -v lazygit >/dev/null && alias lg='lazygit'
