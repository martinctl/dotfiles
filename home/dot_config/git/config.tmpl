# Managed by chezmoi. Machine-specific settings go in ~/.gitconfig, which git also reads (and which wins).
[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main

# delta: readable diffs (syntax highlighting, line numbers); light or dark like the terminal
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	# n / N jump to the next / previous file in a long diff
	navigate = true
	line-numbers = true
{{- if eq .chezmoi.os "windows" }}
	# Git for Windows ships `less` but doesn't put it on PATH
	pager = \"C:/Program Files/Git/usr/bin/less.exe\" -R
{{- end }}
[merge]
	# conflicts also show the common ancestor, which makes them easier to resolve
	conflictStyle = zdiff3
