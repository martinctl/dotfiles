"$schema" = 'https://starship.rs/config-schema.json'

# Minimal one-line prompt: no background blocks, no filler words.
# The leading badge shows the system: mac (grey), win (blue), wsl (orange).
add_newline = false
format = "{{ if eq .chezmoi.os "windows" }}[ win](bold #3794ff){{ else if eq .chezmoi.os "darwin" }}[ mac](bold #c8c8c8){{ else if .wsl }}[ wsl](bold #E95420){{ else }}[ linux](bold #f2c94c){{ end }} $directory$git_branch$git_status$nodejs$golang$python$cmd_duration$character"
right_format = "$time"

[directory]
truncation_length = 4
style = "bold #91ddff"
read_only = " "
read_only_style = "#ff6b6b"
format = "[$path]($style)[$read_only]($read_only_style) "

[git_branch]
symbol = " "
style = "#95ffa4"
format = "[$symbol$branch]($style) "

[git_status]
style = "#f2c94c"
format = "([$all_status$ahead_behind]($style) )"

[nodejs]
symbol = " "
style = "#8cc265"
format = "[$symbol$version]($style) "
version_format = "${major}.${minor}"

[golang]
symbol = " "
style = "#00add8"
format = "[$symbol$version]($style) "
version_format = "${major}.${minor}"

[python]
symbol = " "
style = "#f7d154"
format = "[$symbol$version( \\($virtualenv\\))]($style) "
version_format = "${major}.${minor}"

[cmd_duration]
min_time = 2000
style = "#888888"
format = "[ $duration]($style) "

[character]
success_symbol = "[❯](bold #95ffa4)"
error_symbol = "[❯](bold #ff6b6b)"

[time]
disabled = false
time_format = "%H:%M:%S"
style = "#666666"
format = "[$time]($style)"
