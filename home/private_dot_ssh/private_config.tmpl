# Managed by chezmoi. Keys are NOT in the repo: every machine has its own.
# Personal servers go in ~/.ssh/config.d/ (one file per project), outside the repo.
Include config.d/*
{{- if ne .chezmoi.os "windows" }}

# GitHub: one key per machine (ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_github)
Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github
{{- end }}
